---
import Layout from "@layouts/Layout.astro";
import TerminalList from "@components/TerminalList.svelte";
import TerminalListItem from "@components/TerminalListItem.svelte";

const title = "Hi.";
const description = "Some of my notes, served as a website";
const topLevelDirectories = ["notes", "meta"];
const username = "th7mo"
const externalListItems = [
    {
        href: "https://github.com",
        displayName: "GitHub"
    },
    {
        href: "https://soundcloud.com",
        displayName: "SoundCloud"
    },
    {
        href: "https://instagram.com",
        displayName: "Instagram"
    }
];
---

<Layout title={title} description={description}>
    <p>{description} :)</p>

    <TerminalList>
        {topLevelDirectories.map(listItem => (
            <TerminalListItem dir>
                <a href={listItem}>{listItem}/</a>
            </TerminalListItem>
        ))}
    </TerminalList>

    <TerminalList>
        {externalListItems.map(listItem => (
            <TerminalListItem executable>
                <a
                    target="_blank"
                    href={listItem.href + "/" username}
                >
                    {listItem.displayName}
                </a>
            </TerminalListItem>
        ))}
    </TerminalList>
</Layout>
